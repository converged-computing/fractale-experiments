{
  "attributes": {
    "system": {
      "duration": 120,
      "job": {
        "name": "metrics-quicksilver-cpu"
      }
    },
    "user": {
      "container": {
        "arch": "arm64",
        "libc_flavor": "glibc",
        "libc_version": "2.35",
        "mpi": "openmpi",
        "os_codename": "jammy",
        "os_id": "ubuntu",
        "os_version_id": "22.04"
      },
      "image": "ghcr.io/converged-computing/metrics-quicksilver-cpu:hpc7g",
      "requirement_rationale": "the arm64 build of the same workload",
      "scaled_down": {
        "from": "--nParticles 10000000 --nSteps 10",
        "why": "1000 particles for one step instead of 10 million for ten"
      }
    }
  },
  "requires": {
    "architecture": [
      {
        "type": "arm64"
      }
    ]
  },
  "resources": [
    {
      "count": 2,
      "label": "default",
      "type": "slot",
      "with": [
        {
          "count": 1,
          "exclusive": true,
          "type": "node"
        }
      ]
    }
  ],
  "tasks": [
    {
      "command": [
        "qs",
        "--inputFile",
        "/opt/quicksilver/Examples/CORAL2_Benchmark/Problem1/Coral2_P1.inp",
        "--nParticles",
        "1000",
        "--nSteps",
        "1"
      ],
      "count": {
        "per_slot": 1
      },
      "slot": "default"
    }
  ],
  "version": 1
}
