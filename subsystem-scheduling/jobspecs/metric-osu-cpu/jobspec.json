{
  "attributes": {
    "system": {
      "duration": 120,
      "job": {
        "name": "metric-osu-cpu"
      }
    },
    "user": {
      "container": {
        "arch": "amd64",
        "libc_flavor": "glibc",
        "libc_version": "2.35",
        "mpi": "openmpi",
        "os_codename": "jammy",
        "os_id": "ubuntu",
        "os_version_id": "22.04"
      },
      "image": "ghcr.io/converged-computing/metric-osu-cpu:libfabric",
      "nodes_reduced": {
        "from": 5,
        "to": 2,
        "why": "the clusters that satisfy its requires have 2 node(s): sched-eks-cpu-efa-bigmem, sched-gke-bigmem, sched-gke-cpu"
      },
      "requirement_rationale": "a collective latency measurement, so the fabric is the requirement",
      "scaled_down": {
        "from": "-m 8:1048576 -i 1000 -f",
        "why": "up to 4KB and 10 iterations: enough to prove the collective works"
      }
    }
  },
  "requires": {
    "architecture": [
      {
        "type": "amd64"
      }
    ],
    "network": [
      {
        "type": "anyof",
        "with": [
          {
            "type": "efa"
          },
          {
            "type": "ethernet"
          }
        ]
      }
    ]
  },
  "resources": [
    {
      "count": 2,
      "label": "default",
      "type": "slot",
      "with": [
        {
          "count": 1,
          "exclusive": true,
          "type": "node"
        }
      ]
    }
  ],
  "tasks": [
    {
      "command": [
        "/opt/osu-benchmark/build.openmpi/libexec/osu-micro-benchmarks/mpi/collective/osu_allreduce",
        "-m",
        "8:4096",
        "-i",
        "10",
        "-f"
      ],
      "count": {
        "per_slot": 1
      },
      "slot": "default"
    }
  ],
  "version": 1
}
