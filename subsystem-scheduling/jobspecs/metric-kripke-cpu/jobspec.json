{
  "attributes": {
    "system": {
      "duration": 120,
      "job": {
        "name": "metric-kripke-cpu"
      }
    },
    "user": {
      "container": {
        "arch": "amd64",
        "libc_flavor": "glibc",
        "libc_version": "2.35",
        "mpi": "openmpi",
        "os_codename": "jammy",
        "os_id": "ubuntu",
        "os_version_id": "22.04"
      },
      "image": "ghcr.io/converged-computing/metric-kripke-cpu:libfabric",
      "scaled_down": {
        "from": "--zones 64,64,64 --groups 32 --legendre 4 --quad 32 --niter 10",
        "why": "512 zones, 2 groups, one iteration"
      }
    }
  },
  "requires": {
    "architecture": [
      {
        "type": "amd64"
      }
    ],
    "memory": [
      {
        "type": "anyof",
        "with": [
          {
            "type": "16-64GB"
          },
          {
            "type": "64-192GB"
          },
          {
            "type": "192GB+"
          }
        ]
      }
    ],
    "network": [
      {
        "type": "anyof",
        "with": [
          {
            "type": "efa"
          },
          {
            "type": "ethernet"
          }
        ]
      }
    ]
  },
  "resources": [
    {
      "count": 1,
      "label": "default",
      "type": "slot",
      "with": [
        {
          "count": 1,
          "exclusive": true,
          "type": "node"
        }
      ]
    }
  ],
  "tasks": [
    {
      "command": [
        "kripke",
        "--layout",
        "DGZ",
        "--nest",
        "DGZ",
        "--zones",
        "8,8,8",
        "--procs",
        "1,1,1",
        "--groups",
        "2",
        "--legendre",
        "1",
        "--quad",
        "4",
        "--niter",
        "1"
      ],
      "count": {
        "per_slot": 1
      },
      "slot": "default"
    }
  ],
  "version": 1
}
