{
  "attributes": {
    "system": {
      "duration": 120,
      "job": {
        "name": "metric-mixbench"
      }
    },
    "user": {
      "container": {
        "arch": "amd64",
        "libc_flavor": "glibc",
        "libc_version": "2.35",
        "mpi": "none",
        "os_codename": "jammy",
        "os_id": "ubuntu",
        "os_version_id": "22.04"
      },
      "image": "ghcr.io/converged-computing/metric-mixbench:latest",
      "nodes_reduced": {
        "from": 4,
        "to": 2,
        "why": "the clusters that satisfy its requires have 2 node(s): sched-eks-cpu-efa-bigmem, sched-gke-bigmem"
      },
      "requirement_rationale": "sweeps arithmetic intensity against a fixed buffer: no capacity need"
    }
  },
  "requires": {
    "architecture": [
      {
        "type": "amd64"
      }
    ]
  },
  "resources": [
    {
      "count": 2,
      "label": "default",
      "type": "slot",
      "with": [
        {
          "count": 1,
          "exclusive": true,
          "type": "node"
        }
      ]
    }
  ],
  "tasks": [
    {
      "command": [
        "mixbench-cpu"
      ],
      "count": {
        "per_slot": 1
      },
      "slot": "default"
    }
  ],
  "version": 1
}
