{
  "attributes": {
    "system": {
      "duration": 120,
      "job": {
        "name": "metric-lammps-cpu"
      }
    },
    "user": {
      "container": {
        "arch": "amd64",
        "libc_flavor": "glibc",
        "libc_version": "2.35",
        "mpi": "openmpi",
        "os_codename": "jammy",
        "os_id": "ubuntu",
        "os_version_id": "22.04"
      },
      "image": "ghcr.io/converged-computing/metric-lammps-cpu:libfabric-zen4",
      "nodes_reduced": {
        "from": 3,
        "to": 2,
        "why": "the clusters that satisfy its requires have 2 node(s): sched-eks-cpu-efa-bigmem, sched-gke-bigmem"
      },
      "requirement_rationale": "reaxff on a small cell: compute and communication, not capacity",
      "scaled_down": {
        "from": "-v x 4 -v y 4 -v z 2",
        "why": "2x2x2 replication: enough atoms to divide across ranks, which the unreplicated 304-atom cell is too small to do"
      }
    }
  },
  "requires": {
    "architecture": [
      {
        "type": "amd64"
      }
    ]
  },
  "resources": [
    {
      "count": 2,
      "label": "default",
      "type": "slot",
      "with": [
        {
          "count": 1,
          "exclusive": true,
          "type": "node"
        }
      ]
    }
  ],
  "tasks": [
    {
      "command": [
        "lmp",
        "-in",
        "/opt/lammps/examples/reaxff/HNS/in.reaxff.hns",
        "-v",
        "x",
        "2",
        "-v",
        "y",
        "2",
        "-v",
        "z",
        "2",
        "-log",
        "none"
      ],
      "count": {
        "per_slot": 1
      },
      "slot": "default"
    }
  ],
  "version": 1
}
