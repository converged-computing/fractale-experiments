{
  "attributes": {
    "system": {
      "duration": 120,
      "job": {
        "name": "metric-minife"
      }
    },
    "user": {
      "container": {
        "arch": "amd64",
        "libc_flavor": "glibc",
        "libc_version": "2.35",
        "mpi": "openmpi",
        "os_codename": "jammy",
        "os_id": "ubuntu",
        "os_version_id": "22.04"
      },
      "image": "ghcr.io/converged-computing/metric-minife:libfabric-cpu",
      "nodes_reduced": {
        "from": 3,
        "to": 2,
        "why": "the clusters that satisfy its requires have 2 node(s): sched-eks-cpu-efa-bigmem, sched-gke-bigmem"
      },
      "scaled_down": {
        "from": "-nx 256 -ny 256 -nz 256",
        "why": "4096 unknowns instead of 16.7 million"
      }
    }
  },
  "requires": {
    "architecture": [
      {
        "type": "amd64"
      }
    ],
    "memory": [
      {
        "type": "anyof",
        "with": [
          {
            "type": "16-64GB"
          },
          {
            "type": "64-192GB"
          },
          {
            "type": "192GB+"
          }
        ]
      }
    ],
    "network": [
      {
        "type": "anyof",
        "with": [
          {
            "type": "efa"
          },
          {
            "type": "ethernet"
          }
        ]
      }
    ]
  },
  "resources": [
    {
      "count": 2,
      "label": "default",
      "type": "slot",
      "with": [
        {
          "count": 1,
          "exclusive": true,
          "type": "node"
        }
      ]
    }
  ],
  "tasks": [
    {
      "command": [
        "miniFE.x",
        "-nx",
        "16",
        "-ny",
        "16",
        "-nz",
        "16"
      ],
      "count": {
        "per_slot": 1
      },
      "slot": "default"
    }
  ],
  "version": 1
}
