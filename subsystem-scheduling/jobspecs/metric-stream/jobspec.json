{
  "attributes": {
    "system": {
      "duration": 120,
      "job": {
        "name": "metric-stream"
      }
    },
    "user": {
      "container": {
        "arch": "amd64",
        "libc_flavor": "glibc",
        "libc_version": "2.35",
        "mpi": "none",
        "os_codename": "jammy",
        "os_id": "ubuntu",
        "os_version_id": "22.04"
      },
      "image": "ghcr.io/converged-computing/metric-stream:cpu",
      "nodes_reduced": {
        "from": 3,
        "to": 2,
        "why": "the clusters that satisfy its requires have 2 node(s): sched-eks-cpu-efa-bigmem, sched-gke-bigmem, sched-gke-cpu"
      }
    }
  },
  "requires": {
    "architecture": [
      {
        "type": "amd64"
      }
    ],
    "memory": [
      {
        "type": "anyof",
        "with": [
          {
            "type": "0-16GB"
          },
          {
            "type": "16-64GB"
          },
          {
            "type": "64-192GB"
          },
          {
            "type": "192GB+"
          }
        ]
      }
    ]
  },
  "resources": [
    {
      "count": 2,
      "label": "default",
      "type": "slot",
      "with": [
        {
          "count": 1,
          "exclusive": true,
          "type": "node"
        }
      ]
    }
  ],
  "tasks": [
    {
      "command": [
        "stream_c.exe"
      ],
      "count": {
        "per_slot": 1
      },
      "slot": "default"
    }
  ],
  "version": 1
}
