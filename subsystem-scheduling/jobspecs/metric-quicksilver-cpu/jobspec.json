{
  "attributes": {
    "system": {
      "duration": 120,
      "job": {
        "name": "metric-quicksilver-cpu"
      }
    },
    "user": {
      "container": {
        "arch": "amd64",
        "libc_flavor": "glibc",
        "libc_version": "2.35",
        "mpi": "openmpi",
        "os_codename": "jammy",
        "os_id": "ubuntu",
        "os_version_id": "22.04"
      },
      "image": "ghcr.io/converged-computing/metric-quicksilver-cpu:libfabric-zen4",
      "nodes_reduced": {
        "from": 5,
        "to": 2,
        "why": "the clusters that satisfy its requires have 2 node(s): sched-eks-cpu-efa-bigmem, sched-gke-bigmem"
      },
      "scaled_down": {
        "from": "-X 80 -Y 80 -Z 80 -x 80 -y 80 -z 80 -n 20000000",
        "why": "1000 particles over 4^3 for one step instead of 20 million over 80^3"
      }
    }
  },
  "requires": {
    "architecture": [
      {
        "type": "amd64"
      }
    ],
    "memory": [
      {
        "type": "anyof",
        "with": [
          {
            "type": "16-64GB"
          },
          {
            "type": "64-192GB"
          },
          {
            "type": "192GB+"
          }
        ]
      }
    ],
    "network": [
      {
        "type": "anyof",
        "with": [
          {
            "type": "efa"
          },
          {
            "type": "ethernet"
          }
        ]
      }
    ]
  },
  "resources": [
    {
      "count": 2,
      "label": "default",
      "type": "slot",
      "with": [
        {
          "count": 1,
          "exclusive": true,
          "type": "node"
        }
      ]
    }
  ],
  "tasks": [
    {
      "command": [
        "qs",
        "-i",
        "/opt/quicksilver/Examples/CORAL2_Benchmark/Problem1/Coral2_P1.inp",
        "-X",
        "4",
        "-Y",
        "4",
        "-Z",
        "4",
        "-x",
        "4",
        "-y",
        "4",
        "-z",
        "4",
        "-n",
        "1000",
        "-N",
        "1"
      ],
      "count": {
        "per_slot": 1
      },
      "slot": "default"
    }
  ],
  "version": 1
}
