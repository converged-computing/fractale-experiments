    "plan": {
        "name": "Transform Jobspec Between Managers",
        "steps": [
            {
                "name": "transform",
                "type": "prompt",
                "prompt": "transform_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "from_manager": "slurm",
                    "to_manager": "flux",
                    "script": "#!/bin/bash\n\n# Submit the pipeline as a job with srun job.sh\n\n# Modified from https://github.com/mschubert/clustermq/blob/master/inst/LSF.tmpl\n# under the Apache 2.0 license:\n#SBATCH --job-name=soy_test_alignment\n#SBATCH --output=/dev/null\n#SBATCH --error=/dev/null\n#SBATCH --mem-per-cpu=3000\n#SBATCH --cpus-per-task=1\n#SBATCH -N 1\n#SBATCH -n 72\n#SBATCH --exclusive\n#SBATCH -t 12:00:00\n#SBATCH --mail-user=jhgille2@ncsu.edu\n#SBATCH --mail-type=BEGIN,END,FAIL\n\nmodule load singularity\nsingularity exec conda.sif R CMD BATCH run.R\n\n# Removing .RData is recommended.\n# rm -f .RData\n",
                    "error": "{{ steps.validate.outputs.errors }}",
                    "jobspec": "{{ steps.validate.outputs.jobspec }}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "validate"
                },
                "rules": {
                    "failed": [
                        "not jobspec"
                    ],
                    "success": [
                        "jobspec"
                    ]
                },
                "initial": true
            },
            {
                "name": "validate",
                "type": "prompt",
                "prompt": "validate_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "script": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "manual_validate"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            },
            {
                "name": "manual_validate",
                "type": "tool",
                "tool": "validate_flux_jobspec",
                "inputs": {
                    "content": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            }
        ],
        "inputs": {}
    },
