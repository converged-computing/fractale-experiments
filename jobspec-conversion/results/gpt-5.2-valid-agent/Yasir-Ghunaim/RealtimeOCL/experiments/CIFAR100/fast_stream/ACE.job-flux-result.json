        "name": "Transform Jobspec Between Managers",
        "steps": [
            {
                "name": "transform",
                "type": "prompt",
                "prompt": "transform_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "from_manager": "slurm",
                    "to_manager": "flux",
                    "script": "#!/bin/bash --login\n#SBATCH -N 1\n#SBATCH --partition=batch\n#SBATCH -J ACE\n#SBATCH -o /path/to/output.%J.out\n#SBATCH -e /path/to/error.%J.err\n#SBATCH --time=1:00:00\n#SBATCH --mem=200G\n#SBATCH --ntasks=1\n#SBATCH --gres=gpu\n#SBATCH --cpus-per-task=6\n\n\n# activate the conda environment\nmodule purge\nmodule load gcc/11.1.0\nconda activate realtime_ocl\n\n# run the application:\ncd ../../..\npython main.py \\\n--dataset 'cifar100' \\\n--batch_size 10 \\\n--lr 0.001 \\\n--lr_type 'constant' \\\n--batch_delay 0 \\\n--gradient_steps 1 \\\n--output_dir '/path/to/tensorboard/output' \\\n--workers 4 \\\n--method 'ACE' \\\n--seed 123 \\\n--size_replay_buffer 100",
                    "error": "{{ steps.validate.outputs.errors }}",
                    "jobspec": "{{ steps.validate.outputs.jobspec }}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "validate"
                },
                "rules": {
                    "failed": [
                        "not jobspec"
                    ],
                    "success": [
                        "jobspec"
                    ]
                },
                "initial": true
            },
            {
                "name": "validate",
                "type": "prompt",
                "prompt": "validate_jobspec_expert",
                "allow_tools": false,
                "inputs": {
