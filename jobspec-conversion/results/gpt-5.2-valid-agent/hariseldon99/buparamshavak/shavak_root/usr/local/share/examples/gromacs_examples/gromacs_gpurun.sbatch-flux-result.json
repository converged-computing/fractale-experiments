    "plan": {
        "name": "Transform Jobspec Between Managers",
        "steps": [
            {
                "name": "transform",
                "type": "prompt",
                "prompt": "transform_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "from_manager": "slurm",
                    "to_manager": "flux",
                    "script": "#!/bin/bash\n\n#SBATCH --job-name=gromacstest\n#This sets the name of the job\n\n#SBATCH --partition=GPU\n#This sets the partition to the GPU partition. Important for GPU jobs\n\n#SBATCH --gres=gpu:1\n#This allocates 1 GPU as a Global Resource (gres). Important for GPU jobs\n\n#SBATCH --ntasks=10\n#This sets the number of processes to 10.\n\n#SBATCH --cpus-per-task=1\n#This allocates the number of cpus per tasks. \n\n#SBATCH --time=01:00:00 \n#This allocates the walltime to 60 minutes. The program will not run for longer.\n\nexport GMX_IMGDIR=${SIFDIR}/gromacs/\nexport GMX_IMG=gromacs-2022.3_20230206.sif\nexport TOPOL_FILE=topol.tpr\n\nsingularity run --nv -B ${PWD}:/host_pwd --pwd /host_pwd  $GMX_IMGDIR/$GMX_IMG gmx mdrun -ntmpi 1 -nb gpu -pin on -v -noconfout -nsteps 5000 -ntomp ${SLURM_NTASKS} -s $TOPOL_FILE\n#DO NOT USE 'srun' as it launches multiple independent jobs\n",
                    "error": "{{ steps.validate.outputs.errors }}",
                    "jobspec": "{{ steps.validate.outputs.jobspec }}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "validate"
                },
                "rules": {
                    "failed": [
                        "not jobspec"
                    ],
                    "success": [
                        "jobspec"
                    ]
                },
                "initial": true
            },
            {
                "name": "validate",
                "type": "prompt",
                "prompt": "validate_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "script": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "manual_validate"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            },
            {
                "name": "manual_validate",
                "type": "tool",
                "tool": "validate_flux_jobspec",
                "inputs": {
