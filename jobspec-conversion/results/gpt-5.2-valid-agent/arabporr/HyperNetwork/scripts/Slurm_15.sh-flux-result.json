                    "script": "#!/bin/bash\n#SBATCH --job-name=HN_15\n#SBATCH --qos=normal\n#SBATCH -c 6\n#SBATCH --mem=20G\n#SBATCH --gres=gpu:a40:1\n#SBATCH --time=13:59:00\n#SBATCH --output=HN_15/slurm-%j.out\n#SBATCH --error=HN_15/slurm-%j.err\n\n# Environment Setup\nmodule purge\nmodule load python/3.12.0\npip3 install --upgrade pip\npip3 install -U -q pandas numpy tensorflow cuda-python torch torchvision seaborn plotly matplotlib ipywidgets tqdm\n\n# Run Experiments\npython3 main.py --data_index 15\n",
