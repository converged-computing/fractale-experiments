                    "script": "#!/bin/bash \n#SBATCH -J EQ_POCG_60\n#SBATCH -o out%j.amarel.log\n#SBATCH --export=ALL\n#SBATCH --partition=cmain\n#SBATCH -N 3 -n 96\n##SBATCH -N 1 -n 32\n#SBATCH --mem=6000\n#SBATCH -t 00:30:00       # max time\n#SBATCH --output=starting.out     # STDOUT output file\n#SBATCH --requeue\nmodule purge\nmodule load gcc cuda mvapich2/2.2\nNAMD=\"/projects/jdb252_1/tj227/bin/namd2-2.13-gcc-mvapich2\"\nSRUN=\"srun --mpi=pmi2\"\n$SRUN $NAMD starting.POCG_60.namd > starting.POCG_60.log\n",
                    "error": "{{ steps.validate.outputs.errors }}",
                    "jobspec": "{{ steps.validate.outputs.jobspec }}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "validate"
                },
                "rules": {
                    "failed": [
                        "not jobspec"
                    ],
                    "success": [
                        "jobspec"
                    ]
                },
                "initial": true
            },
            {
                "name": "validate",
                "type": "prompt",
                "prompt": "validate_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "script": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "manual_validate"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            },
            {
                "name": "manual_validate",
                "type": "tool",
                "tool": "validate_flux_jobspec",
                "inputs": {
                    "content": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform"
                },
                "rules": {
