    "plan": {
        "name": "Transform Jobspec Between Managers",
        "steps": [
            {
                "name": "transform",
                "type": "prompt",
                "prompt": "transform_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "from_manager": "slurm",
                    "to_manager": "flux",
                    "script": "#!/bin/bash\n#SBATCH -p long\n#SBATCH --job-name=HEPG2_rna_seq\n#SBATCH --mail-type=END,FAIL\n#SBATCH --mail-user=john.rinn@colorado.edu\n#SBATCH --nodes=1\n#SBATCH --ntasks=1\n#SBATCH --mem=6gb\n#SBATCH --time=20:00:00\n#SBATCH --output=nextflow.out\n#SBATCH --error=nextflow.err\n\npwd; hostname; date\necho \"Here we go You've requested $SLURM_CPUS_ON_NODE core.\"\n\nmodule load singularity/3.1.1\n\nnextflow run nf-core/rnaseq -r 1.4.2 \\\n-resume \\\n-profile singularity \\\n--reads '/scratch/Shares/rinnclass/CLASS_2022/JR/CLASS_2022/class_exeRcises/analysis/17_API_RNASEQ/fastq/*{_read1,_read2}.fastq.gz' \\\n--fasta /scratch/Shares/rinnclass/CLASS_2022/data/genomes/GRCh38.p13.genome.fa \\\n--gtf /scratch/Shares/rinnclass/CLASS_2022/data/gencode.v32.annotation.gtf \\\n--pseudo_aligner salmon \\\n--gencode \\\n--email john.rinn@colorado.edu \\\n-c nextflow.config\n\ndate\n",
                    "error": "{{ steps.validate.outputs.errors }}",
                    "jobspec": "{{ steps.validate.outputs.jobspec }}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "validate"
                },
                "rules": {
                    "failed": [
                        "not jobspec"
                    ],
                    "success": [
                        "jobspec"
                    ]
                },
                "initial": true
            },
            {
                "name": "validate",
                "type": "prompt",
                "prompt": "validate_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "script": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "manual_validate"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            },
            {
                "name": "manual_validate",
                "type": "tool",
                "tool": "validate_flux_jobspec",
                "inputs": {
                    "content": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            }
        ],
