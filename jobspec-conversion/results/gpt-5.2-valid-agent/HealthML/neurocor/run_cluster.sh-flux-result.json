    "plan": {
        "name": "Transform Jobspec Between Managers",
        "steps": [
            {
                "name": "transform",
                "type": "prompt",
                "prompt": "transform_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "from_manager": "slurm",
                    "to_manager": "flux",
                    "script": "#!/bin/bash\n\n#SBATCH --job-name=controljob_%j\n#SBATCH --output=snakemake_%j.log\n#SBATCH --partition=vcpu,hpcpu\n#SBATCH --time=24:00:00\n#SBATCH -c 1\n#SBATCH --mem 2000\n\nSNAKEMAKE_ENV=snakemake\n\n# Initialize conda:\neval \"$(conda shell.bash hook)\"\nconda activate ${SNAKEMAKE_ENV}\n\nsnakemake --snakefile workflow/Snakefile \\\n          --configfile config/config.yaml \\\n\t  --profile ./slurm \\\n          --rerun-triggers mtime \\\n          --directory \"${PWD}\" \\\n\t  \"${@}\"\n\n\n",
                    "error": "{{ steps.validate.outputs.errors }}",
                    "jobspec": "{{ steps.validate.outputs.jobspec }}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "validate"
                },
                "rules": {
                    "failed": [
                        "not jobspec"
                    ],
                    "success": [
                        "jobspec"
                    ]
                },
                "initial": true
            },
            {
                "name": "validate",
                "type": "prompt",
                "prompt": "validate_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "script": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "manual_validate"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            },
            {
                "name": "manual_validate",
                "type": "tool",
                "tool": "validate_flux_jobspec",
                "inputs": {
                    "content": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            }
        ],
        "inputs": {}
