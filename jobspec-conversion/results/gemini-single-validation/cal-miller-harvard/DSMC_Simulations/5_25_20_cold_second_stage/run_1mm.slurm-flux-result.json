    "plan": {
        "name": "Transform Jobspec Between Managers",
        "steps": [
            {
                "name": "transform",
                "type": "prompt",
                "prompt": "transform_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "from_manager": "slurm",
                    "to_manager": "flux",
                    "script": "#!/bin/bash\n#SBATCH -n 16 # Number of cores requested\n#SBATCH -N 1 # Ensure that all cores are on one machine\n#SBATCH -t 0-08:00 # Runtime in minutes\n#SBATCH -p shared # Partition to submit to\n#SBATCH --mem-per-cpu 512 # Memory per cpu in MB (see also ?mem-per-cpu)\n#SBATCH --open-mode=append\n#SBATCH -o logs/dsmc_job_%j.out # Standard out goes to this file\n#SBATCH -e logs/dsmc_job_%j.err # Standard err goes to this filehostname\n\nmodule load intel/19.0.5-fasrc01 openmpi/4.0.2-fasrc01 fftw/3.3.8-fasrc01 cmake/3.12.1-fasrc01 Anaconda3/2019.10 python/3.7.7-fasrc01\nmodule list\n\nexport OMP_PROC_BIND=spread\nexport OMP_PLACES=threads\nexport JULIA_NUM_THREADS=$SLURM_CPUS_ON_NODE\n\necho \"running....\"\n\njulia RunCells.jl -l 0.001 -L 0.02\n",
                    "error": "{{ steps.manual_validate.outputs.errors }}",
                    "jobspec": "{{ steps.manual_validate.outputs.jobspec }}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "validate"
                },
                "rules": {
                    "failed": [
                        "not jobspec"
                    ],
                    "success": [
                        "jobspec"
                    ]
                },
                "initial": true
            },
            {
                "name": "validate",
                "type": "prompt",
                "prompt": "validate_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "script": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "manual_validate",
                    "success": "manual_validate"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            },
            {
                "name": "manual_validate",
                "type": "tool",
                "tool": "validate_flux_jobspec",
                "inputs": {
                    "content": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            }
