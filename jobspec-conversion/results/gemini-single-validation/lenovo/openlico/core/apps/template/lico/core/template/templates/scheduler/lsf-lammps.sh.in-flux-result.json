{
    "steps": [
        {
            "agent": "transform",
            "result": {
                "has_error": false,
                "data": {
                    "jobspec": "noop"
                },
                "attempts": 1
            },
            "transition": "success -> validate",
            "complete": false,
            "state": "success"
        },
        {
            "agent": "validate",
            "result": {
                "has_error": false,
                "data": {
                    "valid": false,
                    "tool_call": false,
                    "reasons": [
                        "The provided input 'noop' is not a valid workload manager batch script.",
                        "The input lacks a resource specification section and contains no schedulable directives."
                    ],
                    "issues": []
                },
                "attempts": 1
            },
            "transition": "failed -> manual_validate",
            "complete": false,
            "state": "failed"
        },
        {
            "agent": "manual_validate",
            "result": {
                "has_error": false,
                "data": {
                    "jobspec": "noop",
                    "errors": [],
                    "valid": true
                }
            },
            "transition": "complete",
            "complete": true,
            "state": "complete"
        }
    ],
    "plan": {
        "name": "Transform Jobspec Between Managers",
        "steps": [
            {
                "name": "transform",
                "type": "prompt",
                "prompt": "transform_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "from_manager": "lsf",
                    "to_manager": "flux",
                    "script": "#!/bin/bash\n#BSUB -J {{ job_name }}\n#BSUB -q {{ job_queue }}\n#BSUB -cwd {{ job_workspace }}\n{% get_now as current %}#BSUB -o {{ job_name }}-{{ current }}.out\n#BSUB -e {{ job_name }}-{{ current }}.out\n\n{% if ram_size %}\n#BSUB -R \"rusage[mem={{ ram_size }}M]\"\n{% endif %}\n\n{% if gpu_per_node or use_gpu %}\n#BSUB -n {{ nodes|default:1|multi:cores_per_node|default:1 }}\n#BSUB -R \"span[ptile={{ cores_per_node|default:1 }}]{% if ram_size %} rusage[mem={{ ram_size }}M]{% endif %}\"\n#BSUB -gpu \"num={{ gpu_per_node|default:1 }}{% if gpu_resource_name %}:mig={{ gpu_resource_name }}{% endif %}:j_exclusive=yes\"\n{% else %}\n#BSUB -n {{ nodes|default:1|multi:cores_per_node|default:1 }}\n{% endif %}\n{% if run_time %}#BSUB -W {% format_lsf_walltime run_time %}{% endif %}\n\nENV_JOB_ID=$LSB_JOBID\n\n\n",
                    "error": "{{ steps.manual_validate.outputs.errors }}",
                    "jobspec": "{{ steps.manual_validate.outputs.jobspec }}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "validate"
                },
                "rules": {
                    "failed": [
                        "not jobspec"
                    ],
                    "success": [
                        "jobspec"
                    ]
                },
                "initial": true
            },
            {
                "name": "validate",
                "type": "prompt",
                "prompt": "validate_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "script": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "manual_validate",
                    "success": "manual_validate"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            },
            {
                "name": "manual_validate",
                "type": "tool",
                "tool": "validate_flux_jobspec",
                "inputs": {
                    "content": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            }
        ],
        "inputs": {}
    }
}