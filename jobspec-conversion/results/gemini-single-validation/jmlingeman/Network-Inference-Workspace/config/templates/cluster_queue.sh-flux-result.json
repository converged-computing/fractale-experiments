{
    "steps": [
        {
            "agent": "transform",
            "result": {
                "has_error": false,
                "data": {
                    "jobspec": "noop"
                },
                "attempts": 1
            },
            "transition": "success -> validate",
            "complete": false,
            "state": "success"
        },
        {
            "agent": "validate",
            "result": {
                "has_error": false,
                "data": {
                    "valid": false,
                    "tool_call": false,
                    "reasons": [
                        "The provided input 'noop' is not a valid workload manager batch script.",
                        "The input lacks a resource specification section and contains no schedulable directives."
                    ],
                    "issues": []
                },
                "attempts": 1
            },
            "transition": "failed -> manual_validate",
            "complete": false,
            "state": "failed"
        },
        {
            "agent": "manual_validate",
            "result": {
                "has_error": false,
                "data": {
                    "jobspec": "noop",
                    "errors": [],
                    "valid": true
                }
            },
            "transition": "complete",
            "complete": true,
            "state": "complete"
        }
    ],
    "plan": {
        "name": "Transform Jobspec Between Managers",
        "steps": [
            {
                "name": "transform",
                "type": "prompt",
                "prompt": "transform_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "from_manager": "pbs",
                    "to_manager": "flux",
                    "script": "#!/bin/bash\n\n#PBS -l nodes={{cluster_nodes}}:ppn={{cluster_procs}},walltime=5:00:00\n#PBS -N {{cluster_expname}}\n#PBS -e localhost:$PBS_O_WORKDIR/${PBS_JOBNAME}.e${PBS_JOBID}\n#PBS -o localhost:$PBS_O_WORKDIR/${PBS_JOBNAME}.o${PBS_JOBID}\n\nQSUB_PRIORITY={{cluster_priority}}\n\nQSUB_CMD=\"-v {{cluster_prog_script}}\"\necho \"Sending the following command to QSUB: $QSUB_CMD\"\n\n#$QSUB_CMD\nqsub $QSUB_CMD\n\n",
                    "error": "{{ steps.manual_validate.outputs.errors }}",
                    "jobspec": "{{ steps.manual_validate.outputs.jobspec }}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "validate"
                },
                "rules": {
                    "failed": [
                        "not jobspec"
                    ],
                    "success": [
                        "jobspec"
                    ]
                },
                "initial": true
            },
            {
                "name": "validate",
                "type": "prompt",
                "prompt": "validate_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "script": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "manual_validate",
                    "success": "manual_validate"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            },
            {
                "name": "manual_validate",
                "type": "tool",
                "tool": "validate_flux_jobspec",
                "inputs": {
                    "content": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            }
        ],
        "inputs": {}
    }
}