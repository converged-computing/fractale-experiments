    "plan": {
        "name": "Transform Jobspec Between Managers",
        "steps": [
            {
                "name": "transform",
                "type": "prompt",
                "prompt": "transform_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "from_manager": "slurm",
                    "to_manager": "flux",
                    "script": "#!/bin/bash\n#SBATCH --job-name=matlab-svd    # create a short name for your job\n#SBATCH --nodes=1                # node count\n#SBATCH --ntasks=1               # total number of tasks across all nodes\n#SBATCH --cpus-per-task=1        # cpu-cores per task (>1 if multi-threaded tasks)\n#SBATCH --mem-per-cpu=4G         # memory per cpu-core (4G is default)\n#SBATCH --time=00:02:00          # total run time limit (HH:MM:SS)\n#SBATCH --gres=gpu:1             # number of gpus per node\n#SBATCH --reservation=gpuprimer  # REMOVE THIS LINE AFTER THE WORKSHOP\n\nmodule purge\nmodule load matlab/R2019a\n\nmatlab -singleCompThread -nodisplay -nosplash -r svd_matlab\n",
                    "error": "{{ steps.manual_validate.outputs.errors }}",
                    "jobspec": "{{ steps.manual_validate.outputs.jobspec }}"
                },
                "transitions": {
                    "failed": "transform",
                    "success": "validate"
                },
                "rules": {
                    "failed": [
                        "not jobspec"
                    ],
                    "success": [
                        "jobspec"
                    ]
                },
                "initial": true
            },
            {
                "name": "validate",
                "type": "prompt",
                "prompt": "validate_jobspec_expert",
                "allow_tools": false,
                "inputs": {
                    "script": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "manual_validate",
                    "success": "manual_validate"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            },
            {
                "name": "manual_validate",
                "type": "tool",
                "tool": "validate_flux_jobspec",
                "inputs": {
                    "content": "{{steps.transform.outputs.jobspec}}"
                },
                "transitions": {
                    "failed": "transform"
                },
                "rules": {
                    "success": [
                        "valid"
                    ],
                    "failed": [
                        "not valid"
                    ]
                }
            }
        ],
        "inputs": {}
    }
